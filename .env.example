# Copy to .env and fill in your own key. Get a free one at https://console.groq.com/keys

GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Cheaper model used by the optional cross-validation gate
GROQ_VALIDATOR_MODEL=openai/gpt-oss-20b

# --- Optional tuning -------------------------------------------------------
# AGENT_MAX_ITERATIONS=12
# AGENT_MAX_RETRIES=3
# AGENT_REQUEST_TIMEOUT_MS=60000
# AGENT_TEMPERATURE=0.1
# AGENT_MAX_TOKENS=2048
# AGENT_CONTEXT_CHARS=28000
# AGENT_CROSS_VALIDATION=false
# AGENT_PRICE_IN_PER_MTOK=0
# AGENT_PRICE_OUT_PER_MTOK=0
